# Personal settings for BSS-DynamicRebalancing-RL. Template only: never put real values here.
#
# Copy it to your user settings file and fill in what you need:
#     bss-settings init          # creates ~/.config/bss-rebalancing/.env (mode 600)
# or to ./.env in your checkout (git-ignored). Real environment variables override both,
# and BSS_ENV_FILE=/path/to/file points to another user file.
# `bss-settings check` shows which settings are set and where from (never the values).
# The file can also be `source`d by shell scripts; `export NAME=value` works too.
# See docs/configuration.md.

# --- Traffic data (bss-scenario traffic collect, issue #17) ----------------------------------
# TomTom Routing API key: https://developer.tomtom.com
TOMTOM_API_KEY=

# Google Routes API key, for the travel-time cross-check (issue #58)
GOOGLE_MAPS_API_KEY=

# --- Experiment tracking (bss-train / train_grid --wandb) ------------------------------------
# API key from https://wandb.ai/authorize
WANDB_API_KEY=
# User or team that owns the runs (empty: your W&B default entity)
WANDB_ENTITY=
# Project name (empty: bss-rebalancing)
WANDB_PROJECT=
# online (default) or offline
WANDB_MODE=
